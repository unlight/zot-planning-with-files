{
  "name": "zot-planning-with-files",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "zot extension for the planning-with-files workflow",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsdown && chmod +x dist/index.js",
    "test": "npm run build && node --test test/extension.test.ts",
    "typecheck": "tsc --noEmit",
    "eslint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "eslint:fix": "npm run eslint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run eslint && npm run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24.19.2",
    "changelog-sentence-case": "^1.0.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
